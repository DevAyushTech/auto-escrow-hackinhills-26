APP_NAME=Auto Escrow API
APP_ENV=development
DATABASE_URL=sqlite:///./auto_escrow.db
# Used only when APP_ENV=test; it keeps test data isolated from development.
TEST_DATABASE_URL=sqlite:///./test_auto_escrow.db
# Comma-separated exact browser origins; development also allows local Vite origins.
FRONTEND_ORIGIN=http://localhost:5173
MAX_SUBMISSION_RETRIES=2
DEMO_RESOLUTION_OPERATOR=demo-operator
# Public synthetic sandbox controls. Keep disabled for ordinary local API use;
# enable only after the session isolation tests pass in the deployed environment.
DEMO_PUBLIC_ENABLED=false
DEMO_SEED_ENABLED=false
DEMO_SESSION_TTL_MINUTES=120
DEMO_MAX_JOBS_PER_SESSION=3
DEMO_RATE_LIMIT_PER_MINUTE=120
DEMO_SESSION_CREATE_LIMIT_PER_HOUR=10
DEMO_MAX_REQUEST_BYTES=300000
